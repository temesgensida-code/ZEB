DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://<your-service>.onrender.com,https://<your-app>.netlify.app
DJANGO_CORS_ALLOWED_ORIGINS=https://<your-app>.netlify.app,http://localhost:5173
DJANGO_CORS_ALLOW_CREDENTIALS=False
# Render terminates TLS upstream — keep this False to avoid redirect loops
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=31536000
GOOGLE_SAFE_BROWSING_API_KEY=replace-with-your-key
